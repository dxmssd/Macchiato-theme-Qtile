{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/dante/Descargas/b.jpg",
    "width": 30,
    "height": 23
  },
  "display": {
    "separator": " : ",
    "key": {
      "type": "icon"
    },
    "color": {
      "output": "white"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────────── User ──────────────────────────┐"
    },
    {
      "type": "title",
      "key": "   User",
      "keyColor": "magenta",
      "format": "{1}@{2}",
      "character": " "
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────┘"
    },
    "break", 
    {
      "type": "custom",
      "format": "┌─────────────────────── Hardware ───────────────────────┐"
    },
    {
      "type": "host",
      "key": "  󰌢 Host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "  ├──  CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "  ├── 󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "  ├──  Mem",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  └── 󰋊 Disk",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌─────────────────────── Software ───────────────────────┐"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "  ├──  Ker",
      "keyColor": "cyan"
    },
    {
      "type": "shell",
      "key": "  ├──  Sh",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "  └──  Term",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌─────────────────────── Time / Update ──────────────────┐"
    },
    {
      "type": "uptime",
      "key": "  󱎫 Up",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "  ├── 󰚰 Last Upd",
      "keyColor": "blue",
      "shell": "fish",
      "text": "date -r /var/log/pacman.log '+%Y-%m-%d %H:%M:%S'"
    },
    {
      "type": "datetime",
      "key": "  └──  Date",
      "keyColor": "blue",
      "format": "{4} {5} "
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}